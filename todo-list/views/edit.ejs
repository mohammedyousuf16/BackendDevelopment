<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title> 
</head>
<body>

    <div class="main w-full min-h-screen bg-zinc-900 p-10 text-white">
        <a class="text-blue-500 inline-block mb-10" href="/">Go back home</a>

       <form action="/edit" method="post">
                <!-- <p class="block w-1/4 rounded-md text-zinc-500 outline-none px-5 py-2 " type="text"  name="previous"> Change name from <%= filename %> </p> -->
                <input class="block w-1/4 rounded-md text-zinc-500 outline-none px-5 py-2 bg-zinc-800" type="text" value="<%= filename %>" name="previous" readonly>

                <input class="block w-1/4 rounded-md outline-none px-5 py-2 bg-zinc-800 mt-2" type="text" placeholder="New name" name="new">
                <input class="mt-2 bg-yellow-600 px-5 py-2 rounded-md" type="submit" value="Update Name">
            </form>
        </div>
    <script src="/javascript/script.js"</script></script>
</body>
</html>